{
  "name": "shared-schemas",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "echo 'No watch needed - using source files directly'"
  },
  "dependencies": {
    "zod": "catalog:zod"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "catalog:"
  }
}
