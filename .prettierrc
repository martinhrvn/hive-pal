{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "overrides": [
    {
      "files": ["apps/frontend/public/locales/**/*.json"],
      "options": {
        "printWidth": 0
      }
    }
  ]
}
