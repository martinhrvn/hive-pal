{
  "name": "e2e",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "test": "playwright test",
    "test:ui": "dotenv  -e .env.local -- playwright test --ui",
    "test:local": "dotenv  -e .env.local -- playwright test",
    "test:preview": "dotenv -e .env.preview -- playwright test",
    "test:preview:ui": "dotenv -e .env.preview -- playwright test --ui",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:smoke:local": "dotenv -e .env.local -- playwright test -c playwright.smoke.config.ts",
    "test:smoke:ui": "dotenv -e .env.local -- playwright test -c playwright.smoke.config.ts --ui",
    "test:e2e": "playwright test -c playwright.smoke.config.ts; s=$?; playwright test -c playwright.guides.config.ts && exit $s",
    "test:guides": "playwright test -c playwright.guides.config.ts",
    "guides:voice": "GUIDE_PREPARE=1 playwright test -c playwright.guides.config.ts",
    "guides:record": "GUIDE=1 playwright test -c playwright.guides.config.ts",
    "guides:thumbnail": "node guides/thumbnail/render.mjs",
    "guides:take": "node --experimental-transform-types --no-warnings guides/voice-take.mjs",
    "guides:metadata": "node --experimental-strip-types --no-warnings guides/youtube-cli.mjs"
  },
  "devDependencies": {
    "@playwright/test": "catalog:playwright",
    "@types/node": "^22.20.5",
    "dotenv-cli": "^11.0.0",
    "page-objects": "workspace:*"
  },
  "dependencies": {
    "uuid": "^14.0.3"
  }
}
