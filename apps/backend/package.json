  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "db:up": "docker compose up -d",
    "db:up:test": "docker compose -f docker-compose-testdb.yml up -d",
    "dev": "pnpm db:up && dotenvx run -f .env -- nest start --watch",
    "seed": "ts-node prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "pnpm test:e2e",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --coverage",
    "test:e2e": "dotenvx run -f .env.test -- prisma migrate deploy && dotenvx run -f .env.test -- vitest run --project e2e"
  },
