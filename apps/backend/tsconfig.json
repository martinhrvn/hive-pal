{
  "compilerOptions": {
    "module": "commonjs",
    // TypeScript 6 deprecates node10 resolution; keep the current behaviour.
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    // TypeScript 6 defaults every strict flag and an empty `types` list.
    // Keep the flags this project has always run with.
    "strict": false,
    "types": ["node", "multer"],
    "noUncheckedSideEffectImports": false,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/prisma/client": ["./src/generated/prisma/client"]
    }
  },
  "exclude": ["node_modules", "dist", "vitest.config.ts"]
}
