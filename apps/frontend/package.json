    "prerender": "node scripts/prerender-ssr.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:watch": "vitest --watch",
